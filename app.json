{
  "expo": {
    "name": "Would You Rather",
    "slug": "would-you-rather",
    "owner": "hair.lab.cairo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wyr",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hairlabcairo.wyr",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.hairlabcairo.wyr",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B10"
      },
      "permissions": [
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/placeholder-project-id"
    },
    "plugins": [
      "expo-localization",
      "expo-sharing",
      "expo-audio"
    ]
  }
}
