{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "ios-unsigned": {
      "channel": "production",
      "distribution": "internal",
      "ios": {
        "withoutCredentials": true,
        "config": "ios-unsigned.yml"
      }
    },
    "production": {
      "android": { "buildType": "apk" },
      "ios": {}
    }
  }
}
